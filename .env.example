# Ollama API endpoint (default: local install)
OLLAMA_HOST=http://127.0.0.1:11434

# Model name. Pull with: ollama pull <model>
# Good options:
#   - llama3.1:8b        (English-strong, ~4.7GB)
#   - qwen2.5:7b         (Great Hinglish/Hindi, ~4.4GB) - recommended
#   - mistral:7b         (Good all-around)
#   - gemma2:9b          (Very natural conversation)
OLLAMA_MODEL=qwen2.5:7b

# Server port
PORT=3000

# Where user data (profiles, chat history) is stored
DATA_DIR=./data
